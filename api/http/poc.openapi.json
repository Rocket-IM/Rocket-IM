          }
        }
      }
    },
    "/v1/close_attempt": {
      "post": {
        "operationId": "close_attempt",
        "description": "封口尚未被 Relay 登记的替代尝试时，必须成对提供当前链尾的 replaces_attempt_id 与 closure_id；接受和封口共用串行事务。可选 envelope_sha256 请求签名封口，值为原信封域分离摘要的64位小写hex，不传Envelope。摘要只绑定鉴权发送者的请求，不证明Service核对了未收到的密文。签名请求无签名器返回503，不降级；旧无证明封口及rejected_final只返回原结果，不补签；逻辑消息已accepted始终优先返回原接受事实。 新签名证明与NULL原尝试、链尾/前驱后继在同一事务保存，签名失败全回滚。签名封口精确重试返回原字节，改摘要/前驱或省略原digest均409；get_attempt可直接恢复原closure_receipt。 已存在accepted原尝试的精确只读路径若被无关到期投影的事件容量错误阻断，将完整回滚该投影并返回原接受事实，附lifecycle_projection_pending:true；保留原availability/期限，不伪造投影完成。改字节、新尝试及非容量错误不走此恢复路径。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../realtime/message.schema.json#/$defs/CloseRequest"
              }
