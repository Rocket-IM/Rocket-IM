{
  "openapi": "3.1.1",
  "info": {
    "title": "Rocket-IM 阶段 0 HTTP Relay POC",
    "version": "rim-poc-1",
    "description": "仅用于本机合成设备与候选 MLS 的协议验证；不是公开发布 API。HTTP 凭证与密码身份分开：Bearer 绑定单个 service/account/device，可信公钥由测试装置带外提供。正文严格 UTF-8 JSON，禁止重复键和未定义字段。请求上限 1 MiB，超时与重试预算见消息协议草案；本实验不声明 TLS/WSS 验证。 签名权限增量支持remove_member/revoke_device及仅from_join的新账号单设备add_member和同账号新设备add_device；bootstrap仍依赖可信合成检查点，生产身份恢复与Q02分叉/新鲜度尚未闭合。启用权限检查点后，测试set_state/revoke_device/add_control不可覆盖该链。 Service恢复凭证公钥只能由新空库固定，重启不得缺失或换钥；Service自有签名seed与用户E2EE解密私钥分离。 历史迁移只支持本群同账号当前设备的显式已验证接收或已验证接受的发送副本，独立定向加密；公开请求由实验调度器搬运，不包含附件、备份或产品发现/通知。 一致性head只签署当前Service所见完整权限CP并绑定调用设备challenge，不证明全局最新或独立视图之间不存在分叉。 Q01新增两步设备私钥持有注册；联系人独立核验与发送/密钥分发门禁由Rust持有，仍使用合成业务token和外部可信核验输入，不成为真实登录或现实身份认证。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "仅本机环回监听，端口由实验进程选择。",
      "variables": {
        "port": {
          "default": "8766"
        }
      }
    }
  ],
  "security": [
    {
      "SyntheticDeviceBearer": []
    }
  ],
  "paths": {
    "/v1/submit_message": {
      "post": {
        "operationId": "submit_message",
        "description": "提交已持久化的不可变信封；替代须绑定封口证明。 已有receipt mode的新接受记录包含acceptance_receipt；Service使用固定公钥对应私钥签名原信封摘要，与接受及所有目标事件同事务提交。签名器失败返回receipt_signer_unavailable/not_recorded且不保留接受。旧无签名记录不补签，精确重试保留原字节。 receipt模式只对原头版本严格落后的新state_stale终态附rejection_receipt，required版本/状态由首次拒绝同事务的会话及一致权限检查点固定。签名器失败或投影不一致返回503/not_recorded并整体回滚。首次及重复409必须完整携带同一证明，get_attempt/close_attempt返回原终态；其他code、future版本及旧无证明拒绝不补签。 已存在accepted原尝试的精确只读路径若被无关到期投影的事件容量错误阻断，将完整回滚该投影并返回原接受事实，附lifecycle_projection_pending:true；保留原availability/期限，不伪造投影完成。改字节、新尝试及非容量错误不走此恢复路径。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../realtime/message.schema.json#/$defs/SubmitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果；是否接受由 result.outcome 判断。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../realtime/message.schema.json#/$defs/AcceptedResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "404": {
            "$ref": "#/components/responses/UnsupportedOperation"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/ResourceExhausted"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/TemporarilyUnavailable"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          }
        }
      }
    },
    "/v1/get_attempt": {
      "post": {
        "operationId": "get_attempt",
        "description": "仅原发送设备读取尝试；not_found 不证明在途请求永远不会提交。 接受证明仅是原接受事实，返回当前availability而不返回正文或原Envelope；取得旧证明不恢复删除、过期或失权内容的访问和迁移权限。 已存在accepted原尝试的精确只读路径若被无关到期投影的事件容量错误阻断，将完整回滚该投影并返回原接受事实，附lifecycle_projection_pending:true；保留原availability/期限，不伪造投影完成。改字节、新尝试及非容量错误不走此恢复路径。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../realtime/message.schema.json#/$defs/AttemptRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作结果；是否接受由 result.outcome 判断。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../realtime/message.schema.json#/$defs/AttemptResultResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "404": {
            "$ref": "#/components/responses/UnsupportedOperation"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
