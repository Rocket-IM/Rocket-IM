  "components": {
    "securitySchemes": {
      "businessBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "rimb_<64 lowercase hex>",
        "description": "仅业务后台持有；设备rimd令牌不得调用。"
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "account",
          "device"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "account": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "device": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        }
      },
      "Identity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "identity_key"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "identity_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_user",
          "account",
          "creator",
          "revoked"
        ],
        "properties": {
          "external_user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "account": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "conversation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "creator": {
            "type": "boolean"
          },
          "credential_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked": {
            "type": "boolean"
          },
          "token": {
            "type": "string",
            "pattern": "^rimd_[0-9a-f]{32}_[0-9a-f]{64}$",
            "description": "秘密；只在凭证签发成功响应返回，不记录到日志。"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized",
                  "forbidden",
                  "scope_mismatch",
                  "invalid_request",
                  "idempotency_conflict",
                  "device_conflict",
                  "device_limit",
                  "device_not_bound",
                  "request_limit",
                  "credential_expired",
                  "credential_revoked",
                  "invalid_expiry",
                  "storage_unavailable"
                ]
              }
            }
          }
        }
      },
      "UsersRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "request_id",
          "external_user"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "external_user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        }
      },
      "DevicesRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "request_id",
          "external_user",
          "account",
          "device",
          "identity_key"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "external_user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "account": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "device": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "identity_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "CredentialsRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "request_id",
          "external_user",
          "account",
          "device",
          "ttl_seconds"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "external_user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "account": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "device": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      },
      "RevocationsRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "request_id",
          "external_user",
          "account",
          "device",
          "credential_id"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "external_user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "account": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "device": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "credential_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        }
      }
    }
  }
}
