{
  "openapi": "3.1.0",
  "info": {
    "title": "Rocket-IM business-alpha1",
    "version": "business-alpha1",
    "description": "固定双设备/单会话的业务身份接入；不接管业务密码，不提供密码成员撤销，目录关联不构成独立信任。"
  },
  "paths": {
    "/v1/business/users": {
      "post": {
        "operationId": "users",
        "security": [
          {
            "businessBearer": []
          }
        ],
        "description": "business-alpha1；request_id在当前业务主体的四操作间共用；规范化原内容可重试，异内容拒绝。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "事务提交后的结果；credentials包含token与原expires_at。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "输入或期限无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "缺失/错误/过期或错误用途凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "主体/账号/设备/Service授权拒绝",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "幂等或身份冲突、凭证过期/撤销",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "并发或开发记录限额",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "存储暂不可用，原请求可重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
